{
  "version": 2,
  "projects": [
    {
      "id": "project-template",
      "description": "In-repo starter Blueprint template rendered as a small reference site.",
      "source": {
        "kind": "in_repo_project",
        "project_root": "project_template"
      },
      "targets": [
        {
          "release": "v4.32.0"
        },
        {
          "release": "v4.33.0"
        }
      ],
      "generate_command": ["lake", "exe", "vbp", "build", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    },
    {
      "id": "spherepackingblueprint",
      "description": "External blueprint project without project-specific browser regressions.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-sphere-packing.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.32.0",
          "ref": "c7eee39480088000d2b7e7245a7be3b8bd43e6fb",
          "publish_reference": true
        }
      ],
      "generate_command": ["lake", "exe", "vbp", "build", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    }
  ]
}
