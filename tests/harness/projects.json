{
  "version": 2,
  "projects": [
    {
      "id": "project-template",
      "description": "In-repo starter Blueprint template rendered as a small reference site.",
      "source": {
        "kind": "in_repo_project",
        "project_root": "project_template"
      },
      "targets": [
        {
          "release": "v4.34.0"
        },
        {
          "release": "v4.35.0",
          "rc": "4.35-rc4"
        }
      ],
      "generate_command": [
        "lake",
        "exe",
        "vbp",
        "build",
        "--output",
        "{output_dir}"
      ],
      "site_subdir": "html-multi"
    },
    {
      "id": "noperthedron",
      "description": "Mathlib-heavy external blueprint project kept for generation coverage.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-noperthedron.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.34.0",
          "ref": "42e09b80f07c57662523b9cc0f9655edcda87da9",
          "publish_reference": true,
          "reference_toolchain": "v4.34.0"
        }
      ],
      "generate_command": [
        "lake",
        "exe",
        "vbp",
        "build",
        "--output",
        "{output_dir}"
      ],
      "site_subdir": "html-multi"
    },
    {
